# Claude API
ANTHROPIC_API_KEY=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CONTENT_CHANNEL=

# Database
DATABASE_URL=

# Cron shared secret (set this yourself, do not let Cursor pick one)
# Railway cron jobs must send X-Cron-Secret: <this value>
CRON_SECRET=

# Meta Graph API — organic Facebook Page publishing (direct Graph, not ads)
# BICCU (default brand). Page Access Token from Graph API Explorer (Nova-Agent).
META_PAGE_ID=120368170965
META_PAGE_ACCESS_TOKEN=
META_API_VERSION=v23.0

# KGC / The Kemis Group — separate Page Access Token (page-scoped).
# Also set meta_page_id on the kgc brand config (seed + DB).
META_KGC_PAGE_ACCESS_TOKEN=

# Image generation (optional locally; required on Railway for Slack/Meta image URLs)
# IMAGE_DIR=/data/images
# IMAGE_BASE_URL=https://nova-production-14f6.up.railway.app
# IMAGE_LLM_MODEL=claude-sonnet-4-6

